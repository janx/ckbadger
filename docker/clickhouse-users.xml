<?xml version="1.0"?>
<clickhouse>
    <profiles>
        <default>
            <!-- Memory limit per query: 8GB (increased for larger INSERT batches) -->
            <max_memory_usage>8000000000</max_memory_usage>
            <!-- Memory limit for all queries by user: 16GB -->
            <max_memory_usage_for_user>16000000000</max_memory_usage_for_user>
            <!-- Max concurrent queries per user -->
            <max_concurrent_queries_for_user>10</max_concurrent_queries_for_user>
            <!-- Query timeout: 60 seconds -->
            <max_execution_time>60</max_execution_time>
            <!-- Start delaying INSERTs when table has 300 parts (prevents runaway merges) -->
            <parts_to_delay_insert>300</parts_to_delay_insert>
            <!-- Fail INSERTs when table has 600 parts (hard limit for safety) -->
            <parts_to_throw_insert>600</parts_to_throw_insert>
            <!-- Background merge threads: 32 (increased from 16 for faster merges) -->
            <background_pool_size>32</background_pool_size>
        </default>
    </profiles>
</clickhouse>
