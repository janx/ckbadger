# ckbadger-store RocksDB data path
CKBADGER_DATA_PATH=./data/ckbadger-store

# CKB Node Configuration
# CKB_NODE_MODE: Controls how ckbadger connects to CKB node
#   - "internal": Run CKB node inside Docker (default, recommended for quick start)
#   - "external": Use existing CKB node running on host machine
CKB_NODE_MODE=internal

# CKB RPC URL
# For internal mode: automatically set to http://ckb-node:8114
# For external mode: set to your host CKB node RPC (e.g., http://host.docker.internal:8114)
CKB_RPC_URL=http://localhost:8114
CKB_NETWORK=mainnet

# CKB RocksDB direct read (bypasses JSON-RPC for ~150x faster block reads)
# For local (non-Docker) development:
CKB_DATA_PATH=/var/lib/ckb/data/db
# For Docker external mode: host CKB root dir, mounted at /var/lib/ckb in containers
# CKB_HOST_DATA_DIR=/path/to/your/ckb/data

REDIS_URL=redis://localhost:6379

API_PORT=3001
API_HOST=0.0.0.0
API_RATE_LIMIT=100
API_RATE_LIMIT_BURST=200

RUST_LOG=info

# Token labels path for script/UDT metadata
TOKEN_LABELS_PATH=docs/token-labels

NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:3001/ws
