# ckbadger domain RocksDB data path
CKBADGER_DOMAIN_DATA_PATH=./data/ckbadger-store
# ckbadger append-only RocksDB data path
CKBADGER_APPEND_ONLY_DATA_PATH=./data/ckbadger-store-append-only

# CKB Node Configuration
# For internal node (Docker): set COMPOSE_PROFILES=internal
# For external node (host):   leave COMPOSE_PROFILES unset
# COMPOSE_PROFILES=internal
CKB_RPC_URL=http://172.17.0.1:8114
CKB_NETWORK=mainnet

# CKB RocksDB direct read (bypasses JSON-RPC for ~150x faster block reads)
# For local (non-Docker) development:
CKB_DATA_PATH=/var/lib/ckb/data/db
# For Docker external mode: host CKB root dir, mounted at /var/lib/ckb in containers
# CKB_HOST_DATA_DIR=/path/to/your/ckb/data

REDIS_URL=redis://localhost:6379

API_PORT=3001
API_HOST=0.0.0.0
API_RATE_LIMIT=100
API_RATE_LIMIT_BURST=200

RUST_LOG=info

# Token labels path for script/UDT metadata
TOKEN_LABELS_PATH=docs/token-labels

NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:3001/ws
# Server-side API base used by Next.js route handlers (.md/.raw), useful in Docker.
# Example for docker-compose frontend container: http://api:3001/api/v1
CKBADGER_SERVER_API_URL=http://localhost:3001/api/v1

# Verify subcommand (runs outside Docker, calls the ckbadger API)
# Uses a separate env var from CKB_RPC_URL to avoid picking up Docker-internal addresses
CKBADGER_API_URL=http://localhost:3001/api/v1
# VERIFY_CKB_RPC_URL=http://localhost:8114
